{
  "name": "cardhub",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-game card platform (web first, Capacitor mobile later)",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @cardhub/web --filter @cardhub/server dev",
    "build": "pnpm --filter @cardhub/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @cardhub/e2e test",
    "test:smoke": "pnpm --filter @cardhub/e2e test:smoke",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:start": "supabase start",
    "db:start:ci": "supabase start -x realtime,storage-api,imgproxy,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:env": "node scripts/write-local-env.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "supabase": "^2.118.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
