# Copy to .env.local. For local development run `pnpm db:start && pnpm db:env` instead,
# which fills these in for the local Supabase stack.
# Leave them empty to run the app offline (local games only, no accounts).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Game server for online play (defaults to http://localhost:2567).
VITE_GAME_SERVER_URL=
